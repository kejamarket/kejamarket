# KejaMarket Environment Variables Example
# Domain: kejamarket.co.ke

# ── JWT Auth Secret ─────────────────────────────────────
JWT_SECRET=kejamarket_jwt_secret_production_2026_secure

# ── M-Pesa Daraja API ──────────────────────────────────
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY_HERE
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET_HERE
MPESA_PASSKEY=YOUR_PASSKEY_HERE

# ── Payment Details ─────────────────────────────────────
MPESA_PAYBILL=303030
MPESA_ACCOUNT=2057103992

# ── Callback URL ────────────────────────────────────────
MPESA_CALLBACK_URL=https://kejamarket.co.ke/api/mpesa/callback

# ── Environment: sandbox OR live ────────────────────────
MPESA_ENV=sandbox

# ── Server Port ─────────────────────────────────────────
PORT=3001
