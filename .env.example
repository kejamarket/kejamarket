# KejaMarket Environment Variables
# Domain: kejamarket.co.ke
# Copy this file to .env and fill in your values

# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=production
APP_URL=https://kejamarket.co.ke

# ── JWT Auth Secret (use a long random string) ──────────
JWT_SECRET=kejamarket_jwt_secret_production_2026_secure

# ── PostgreSQL Database ─────────────────────────────────
# Free options: Render, Supabase, Neon
# Leave blank to use JSON file database (dev only)
# Render:   postgresql://user:pass@dpg-xxx.frankfurt-postgres.render.com/kejamarket_db
# Supabase: postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres
# Neon:     postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── M-Pesa Daraja API ───────────────────────────────────
# Get from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY_HERE
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET_HERE
MPESA_PASSKEY=YOUR_PASSKEY_HERE
MPESA_PAYBILL=303030
MPESA_ACCOUNT=2057103992
MPESA_CALLBACK_URL=https://kejamarket.co.ke/api/mpesa/callback
# sandbox or live
MPESA_ENV=sandbox

# ── Africa's Talking SMS API ────────────────────────────
# Get from: https://africastalking.com
AT_USERNAME=kejamarket
AT_API_KEY=YOUR_AFRICASTALKING_API_KEY_HERE
AT_SENDER_ID=KejaMarket

# ── Cloudinary Image CDN (Free: 25GB storage) ───────────
# Get from: https://cloudinary.com — free account
# Without this, images are stored as base64 (slow on mobile)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# ── Email Service (Password reset + receipts) ───────────
# Option 1 — Gmail (enable App Passwords in Google Account)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=KejaMarket <noreply@kejamarket.co.ke>

# Option 2 — SendGrid (free 100 emails/day)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=YOUR_SENDGRID_API_KEY

# ── Render Keep-Alive ───────────────────────────────────
RENDER_EXTERNAL_URL=https://kejamarket.onrender.com
