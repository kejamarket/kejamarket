# Keja – Environment Variables
# Copy this file to .env and fill in your Daraja credentials

# ── M-Pesa Daraja API ──────────────────────────────────
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY_HERE
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET_HERE
MPESA_PASSKEY=YOUR_PASSKEY_HERE

# ── Payment Details ─────────────────────────────────────
MPESA_PAYBILL=303030
MPESA_ACCOUNT=2057103992

# ── Callback URL (must be public HTTPS URL) ─────────────
# Once your domain is live, this will be:
MPESA_CALLBACK_URL=https://keja.co.ke/api/mpesa/callback

# ── Environment: sandbox OR live ────────────────────────
MPESA_ENV=sandbox

# ── Server Port ─────────────────────────────────────────
PORT=3001
