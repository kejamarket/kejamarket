{
  "name": "kejamarket",
  "version": "2.0.0",
  "description": "KejaMarket - Kenya's #1 Real Estate & Rental Property Marketplace with Professional Desktop Layout",
  "main": "server.js",
  "homepage": "https://kejamarket.co.ke",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kejamarket/kejamarket.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node start.js",
    "build": "node migrate-db.js && node seed-postgres.js",
    "migrate": "node migrate-db.js",
    "seed": "node seed-postgres.js",
    "dev": "node server.js",
    "test": "node validate.js",
    "test:system": "node test-system.js",
    "test:load": "node load-test.js",
    "test:load:medium": "node load-test.js 500 20",
    "test:load:heavy": "node load-test.js 1000 50",
    "validate": "node validate.js"
